<Window x:Class="PortwatchDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PortwatchDesktop" Title="Portwatch Desktop" Width="1320" Height="880" MinWidth="840" MinHeight="650" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown" Icon="portwatch.ico" Background="{StaticResource Page}" Style="{StaticResource {x:Type Window}}">
    <Grid Margin="24" Background="{StaticResource Page}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="76" Height="76" CornerRadius="22" Background="{StaticResource Sunset}" Margin="0,0,15,0">
                    <Viewbox Margin="7"><Canvas Width="64" Height="64"><Ellipse Width="44" Height="44" Canvas.Left="10" Canvas.Top="5" Fill="#FFE0A1"/><Path Data="M 12,35 L 52,35 M 13,42 L 51,42 M 18,49 L 46,49" Stroke="#D972A7" StrokeThickness="3"/><Path Data="M 19,56 Q 29,30 30,19 M 30,19 Q 16,13 11,25 M 30,19 Q 19,7 12,16 M 30,19 Q 36,3 46,13 M 30,19 Q 47,12 53,24 M 30,19 Q 44,21 45,34" Stroke="#2A1935" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="PORTWATCH" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="31" FontWeight="Black" Foreground="#FFF0E9"/><TextBlock Text="D E S K T O P" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Pink}"/></StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><CheckBox x:Name="AutoFetch" Content="Auto-fetch" Margin="0,0,10,0" Checked="SettingsChanged" Unchecked="SettingsChanged"/><ComboBox x:Name="Interval" Width="88" SelectionChanged="SettingsChanged"/></StackPanel><TextBlock x:Name="NextScan" Text="Next: —" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,5,0,0"/></StackPanel>
                <Button x:Name="FetchButton" Content="Fetch now" ToolTip="Fetch PortWatch and GitHub updates (F5)" Style="{StaticResource PrimaryButton}" Click="FetchButton_Click"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" x:Name="Dashboard" Margin="0,0,0,15">
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="DashboardLeft" Width="2.15*"/><ColumnDefinition x:Name="DashboardRight" Width="1*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Grid.Row="0" x:Name="LeadCards" Margin="0,0,8,12"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="LEADING EFFORT" Style="{StaticResource Caption}" Foreground="{StaticResource Pink}"/><Grid Grid.Row="1" Margin="0,3,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="LeaderName" Text="Waiting for data" FontSize="29" FontWeight="Bold" Foreground="{StaticResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="LeaderScore" Grid.Column="1" Text="—%" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Peach}"/></Grid><Border Grid.Row="2" Height="14" Background="#382A48" CornerRadius="7" x:Name="ProgressTrack" SizeChanged="ProgressTrack_SizeChanged"><Border x:Name="ProgressFill" Background="{StaticResource Sunset}" CornerRadius="7" HorizontalAlignment="Left" Width="0"/></Border><TextBlock Grid.Row="3" x:Name="LeaderMilestone" Text="Awaiting PortWatch data" Style="{StaticResource Caption}" Margin="0,9,0,0"/></Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0"><StackPanel><TextBlock x:Name="ReleaseHeading" Text="TIME SINCE EXECUTABLE RELEASE" Style="{StaticResource Caption}" Foreground="{StaticResource Pink}" TextWrapping="Wrap"/><Viewbox HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,9,0,9"><TextBlock x:Name="ReleaseClock" Text="—d   —h   —m   —s" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" FontSize="26" Foreground="{StaticResource Peach}"/></Viewbox><TextBlock x:Name="ReleaseDetails" Text="Waiting for release timestamp" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
          </Grid>
          <Border Grid.Row="1" x:Name="RaceCard" Style="{StaticResource CardStyle}" Padding="16,12,16,8" Margin="0,0,8,0"><StackPanel><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="THE RACE TO PLAYABLE" Style="{StaticResource Caption}" Foreground="{StaticResource Pink}"/><TextBlock Grid.Column="1" Text="Click a marker" Style="{StaticResource Caption}"/></Grid><local:RaceTrackControl x:Name="RaceTrack" Height="120"/></StackPanel></Border>
          <Border x:Name="BriefCard" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0" Padding="19,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="INTELLIGENCE BRIEF" Style="{StaticResource Caption}" Foreground="{StaticResource Pink}"/><TextBlock Text="The current situation" Foreground="{StaticResource Text}" FontWeight="Bold" FontSize="20" Margin="0,4,0,12"/></StackPanel><TextBlock Grid.Row="1" x:Name="BriefText" Text="Waiting for the first fetch." Foreground="{StaticResource Text}" FontSize="14" LineHeight="21" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" MaxHeight="190"/><TextBlock Grid.Row="2" x:Name="BriefSource" Text="Local analysis · PortWatch + GitHub" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/></Grid></Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Summary" Text="Waiting for PortWatch data" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><CheckBox x:Name="NotifyMilestones" Content="Milestone notifications" Margin="0,0,18,0" Checked="SettingsChanged" Unchecked="SettingsChanged"/><CheckBox x:Name="ShowWatchlist" Content="Show watchlist" Checked="WatchlistChanged" Unchecked="WatchlistChanged" IsChecked="True"/></StackPanel></Grid>
        <TabControl Grid.Row="3" x:Name="Tabs">
            <TabItem Header="Leaderboard" Tag="First"><Border Style="{StaticResource CardStyle}" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="Leaderboard" SelectionChanged="Leaderboard_SelectionChanged" MouseDoubleClick="Leaderboard_DoubleClick"><DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="50" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Project" Binding="{Binding Name}" Width="1.4*" MinWidth="145" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Score" Binding="{Binding ScoreText}" Width="80" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Milestone" Binding="{Binding Stage}" Width="120" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Latest commit" Binding="{Binding CommitTime}" Width="123" ElementStyle="{StaticResource CellText}"/><DataGridTemplateColumn Header="Live check" Width="108"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="9" Padding="9,4" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#382C49"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Updated"><Setter Property="Background" Value="#70445B"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Latest activity" Binding="{Binding CommitTitle}" Width="3*" MinWidth="180" ElementStyle="{StaticResource CellText}"/>
                </DataGrid.Columns></DataGrid><Border Grid.Row="1" Background="{StaticResource CardAlt}" CornerRadius="13" Padding="14" Margin="0,7,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ProjectDetail" Text="Select a project for details." Foreground="{StaticResource Text}" TextWrapping="Wrap" VerticalAlignment="Center" MaxHeight="70"/><Button Grid.Column="1" Content="Open Repo" Margin="10,0,0,0" Click="OpenProject_Click"/></Grid></Border></Grid></Border></TabItem>
            <TabItem Header="Activity"><Border Style="{StaticResource CardStyle}" Padding="8"><DataGrid x:Name="ActivityGrid"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="126" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Project" Binding="{Binding Project}" Width="180" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Event" Binding="{Binding Kind}" Width="140" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*" ElementStyle="{StaticResource CellText}"/></DataGrid.Columns></DataGrid></Border></TabItem>
            <TabItem Header="Candidates" Tag="Last"><Border Style="{StaticResource CardStyle}" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="Candidates" MouseDoubleClick="Candidates_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Repository" Binding="{Binding Repo}" Width="1.7*" MinWidth="220" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="145" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Substance" Binding="{Binding Substance}" Width="100" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Discovered" Binding="{Binding Found}" Width="126" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2.5*" MinWidth="200" ElementStyle="{StaticResource CellText}"/></DataGrid.Columns></DataGrid><Grid Grid.Row="1" Margin="8,8,8,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Unreviewed candidates · Double-click a project to open its public repository." Style="{StaticResource Caption}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Open Repo" Click="OpenCandidate_Click"/></Grid></Grid></Border></TabItem>
        </TabControl>
        <Grid Grid.Row="4" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="Status" Text="Ready" Foreground="{StaticResource Text}"/><TextBlock Text="F11 fullscreen · F5 refresh · Esc return to window" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Save report" Click="SaveReport_Click" Margin="0,0,8,0"/><Button Content="Scan report" Click="ShowReport_Click" Margin="0,0,8,0"/><Button Content="PortWatch site ↗" Click="OpenSite_Click"/></StackPanel></Grid>
    </Grid>
</Window>
